# Copy this file to .env for local development (python-dotenv is loaded by app.py).
# Never commit the real .env file.

# --- Database -----------------------------------------------------------
# Production/deployment: a Supabase/PostgreSQL connection string.
#   Supabase dashboard -> Project Settings -> Database -> Connection string (URI)
# Example: postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
# Local development: leave blank to fall back to a local SQLite file at ./data/jobs.db
DATABASE_URL=

# --- Apify ----------------------------------------------------------------
# https://console.apify.com/account/integrations -> Personal API tokens
APIFY_API_TOKEN=

# --- Optional email notifications (Today's Jobs page) ----------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
