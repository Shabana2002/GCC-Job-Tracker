# Copy to .streamlit/secrets.toml for local testing of the Streamlit-secrets
# path, or paste these into the "Secrets" box in Streamlit Community Cloud
# (App settings -> Secrets) when deploying. Never commit the real secrets.toml.

DATABASE_URL = "postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"
APIFY_API_TOKEN = "apify_api_xxx"

SMTP_HOST = ""
SMTP_PORT = 587
SMTP_USER = ""
SMTP_PASSWORD = ""
SMTP_FROM = ""
SMTP_TO = ""
